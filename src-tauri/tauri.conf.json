{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BIT",
  "version": "0.5.7",
  "identifier": "com.bit.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BIT",
        "width": 1120,
        "height": 740,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "WebView2Loader.dll"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
